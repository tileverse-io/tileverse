<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.tileverse</groupId>
    <artifactId>tileverse-internal</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>tileverse-java-vector-tile-shaded</artifactId>
  <name>Tileverse :: Internal :: java-vector-tile Shaded</name>
  <description>java-vector-tile 1.4.2 with its protobuf-java 4.29.3 runtime relocated, for the decode benchmarks.</description>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <!-- The version declared by java-vector-tile 1.4.2. The root pom manages protobuf-java to another version for the cloud SDKs. -->
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java</artifactId>
        <version>4.29.3</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>no.ecc.vectortile</groupId>
      <artifactId>java-vector-tile</artifactId>
      <version>1.4.2</version>
      <optional>true</optional>
      <exclusions>
        <exclusion>
          <groupId>org.locationtech.jts</groupId>
          <artifactId>jts-core</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>

  <repositories>
    <repository>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <!-- java-vector-tile is published to the OSGeo repository -->
      <id>osgeo</id>
      <name>OSGeo Release Repository</name>
      <url>https://repo.osgeo.org/repository/release/</url>
    </repository>
  </repositories>

  <build>
    <plugins>
      <!--
      The jar is built at generate-resources and shaded at process-resources, before compile. The shaded jar is then the
      artifact of this module when the benchmarks compile, in any reactor build: compile, test, or parallel with -T1C.
      If the shaded jar were built at package, a compile build would compile the benchmarks without java-vector-tile.
      Shade needs the jar. In the next phase, shade runs after the jar, whatever the order of the plugins.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>default-jar</id>
            <phase>generate-resources</phase>
            <configuration>
              <!-- A shaded jar left by an earlier build looks up to date, and would be shaded again. -->
              <forceCreation>true</forceCreation>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <id>shade</id>
            <goals>
              <goal>shade</goal>
            </goals>
            <phase>process-resources</phase>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <artifactSet>
                <includes>
                  <include>no.ecc.vectortile:java-vector-tile</include>
                  <include>com.google.protobuf:protobuf-java</include>
                </includes>
              </artifactSet>
              <relocations>
                <relocation>
                  <pattern>com.google.protobuf</pattern>
                  <shadedPattern>io.tileverse.internal.protobuf</shadedPattern>
                </relocation>
              </relocations>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!--
        The compiler sets the artifact of a module to its classes directory, and would replace the shaded jar. This
        module has no sources.
        -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <executions>
          <execution>
            <id>default-compile</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
